digraph dependencies {
graph [rankdir=TB,bgcolor="transparent",pad="0.45",nodesep="0.26",ranksep="0.65",outputorder=edgesfirst];
node [shape=box,style="rounded,filled",fillcolor="#c7f0c2",color="#23834e",fontname="Helvetica",fontsize=12,margin="0.15,0.09",penwidth=1.5];
edge [color="#698478",arrowsize=0.55,penwidth=0.8];
"AssignmentCount" [id="node-AssignmentCount",label="AssignmentCount\n2 checked results",tooltip="AssignmentCount — Counting sequentially generated assignments by their available choices. Menus may depend on every preceding choice. No independence is assumed."];
"AutomaticBudget" [id="node-AutomaticBudget",label="AutomaticBudget\n2 checked results",tooltip="AutomaticBudget — The finite-index budget for the exact automatic threshold vector used by the execution and shattering theorems. All rate and branching parameters are the same definitions, rather than independently chosen numerical certificates."];
"AutomaticThresholds" [id="node-AutomaticThresholds",label="AutomaticThresholds\n11 checked results",tooltip="AutomaticThresholds — Concrete rate and branching parameters remove the remaining numerical decay premises from the canonical-shape tail. These are finite explicit thresholds; end-to-end component coverage and asymptotic analysis are separate."];
"BalancedProduct" [id="node-BalancedProduct",label="BalancedProduct\n3 checked results",tooltip="BalancedProduct — Pairing branching factors in a left-heavy witness. At least as many small factors as large ones suffice for geometric decay, even when a large factor exceeds one."];
"BinomialLowerTail" [id="node-BinomialLowerTail",label="BinomialLowerTail\n3 checked results",tooltip="BinomialLowerTail — GraphChoices/BinomialLowerTail.lean"];
"Bipartite" [id="node-Bipartite",label="Bipartite\n8 checked results",tooltip="Bipartite — Samplewise orientation and optimum comparisons for the vertex-copy construction in Lemma 2.4. The comparisons hold for every reference orientation, not just a density-minimizing one."];
"BipartiteAllHorizons" [id="node-BipartiteAllHorizons",label="BipartiteAllHorizons\n3 checked results",tooltip="BipartiteAllHorizons — GraphChoices/BipartiteAllHorizons.lean"];
"BlockDensity" [id="node-BlockDensity",label="BlockDensity\n4 checked results",tooltip="BlockDensity — The block occupancy argument applied to actual sampled bipartite graphs. Every successful left vertex supplies one distinct arrival per block, giving a concrete dense vertex set."];
"BlockDensityTailArithmetic" [id="node-BlockDensityTailArithmetic",label="BlockDensityTailArithmetic\n1 checked result",tooltip="BlockDensityTailArithmetic — GraphChoices/BlockDensityTailArithmetic.lean"];
"BlockSampling" [id="node-BlockSampling",label="BlockSampling\n14 checked results",tooltip="BlockSampling — A lower-tail substitute for Lemma 3.3: a bucket hit in every independent block has at least as many occurrences as there are blocks. Disjoint buckets' block-success indicators have nonpositive pairwise covariance."];
"BudgetSimplification" [id="node-BudgetSimplification",label="BudgetSimplification\n3 checked results",tooltip="BudgetSimplification — The exact automatic threshold budget has the expected bilinear growth in reference density, log-skewness and the log-log scale. Explicit constants are kept throughout; no asymptotic or benchmark comparison is assumed."];
"CanonicalCoverage" [id="node-CanonicalCoverage",label="CanonicalCoverage\n3 checked results",tooltip="CanonicalCoverage — Coverage of every actual geometric heavy tree by the counted canonical family. This discharges the hcoverage premise in the earlier conditional shattering and expectation theorems."];
"CanonicalForest" [id="node-CanonicalForest",label="CanonicalForest\n2 checked results",tooltip="CanonicalForest — A canonical geometric shape encoding for every finite connected graph, with a prescribed right root and an exact bijection of vertex sets."];
"CapacityMatching" [id="node-CapacityMatching",label="CapacityMatching\n1 checked result",tooltip="CapacityMatching — The capacitated Hall step in Lemma 3.7. The expansion premise is explicit; it is not assumed to hold for every graph. The preceding analytic module proves the numerical rearrangement that supplies this premise from skewness."];
"CompleteBlockDensity" [id="node-CompleteBlockDensity",label="CompleteBlockDensity\n4 checked results",tooltip="CompleteBlockDensity — GraphChoices/CompleteBlockDensity.lean"];
"CompleteBlockTail" [id="node-CompleteBlockTail",label="CompleteBlockTail\n3 checked results",tooltip="CompleteBlockTail — GraphChoices/CompleteBlockTail.lean"];
"ComponentExpectation" [id="node-ComponentExpectation",label="ComponentExpectation\n6 checked results",tooltip="ComponentExpectation — Turn a tail for actual residual component sizes into an expected load bound. Exceptional samples cost at most T times their probability. This module does not assume or claim a proved component-shattering estimate."];
"ComponentGreedy" [id="node-ComponentGreedy",label="ComponentGreedy\n10 checked results",tooltip="ComponentGreedy — Greedy restricted to an edge-closed set. The logarithm depends on the number of vertices in that set; the benchmark remains the full optimum. No arrival occurrence is discarded or identified in the counting argument."];
"ComponentPruning" [id="node-ComponentPruning",label="ComponentPruning\n3 checked results",tooltip="ComponentPruning — The pruning theorem applied to an actual replay component. Both graph degrees and bipartite sides are proved to agree with the implementation's list neighborhoods; no component-to-tree hypothesis is assumed."];
"ComponentTreeEvents" [id="node-ComponentTreeEvents",label="ComponentTreeEvents\n5 checked results",tooltip="ComponentTreeEvents — Actual large components force either a large left degree or a large left-heavy subtree. The outstanding canonical-enumeration step is kept as an explicit containment premise when combining this with canonical-shape tails."];
"ComponentTrees" [id="node-ComponentTrees",label="ComponentTrees\n3 checked results",tooltip="ComponentTrees — Actual arrival components have spanning trees on exactly their vertex sets. Every selected tree edge is backed by an original arrival occurrence. Converting those trees to the counted canonical shape codes remains separate."];
"ConcreteShattering" [id="node-ConcreteShattering",label="ConcreteShattering\n8 checked results",tooltip="ConcreteShattering — Completely instantiated finite component tails. The sampled-degree cutoff is chosen from an actual source-bucket bound and the logarithmic polynomial cutoff, so neither a mean inequality nor a canonical-coverage premise is left."];
"DecomposedAlgorithm" [id="node-DecomposedAlgorithm",label="DecomposedAlgorithm\n3 checked results",tooltip="DecomposedAlgorithm — A quantitative expected-cost theorem for an actual online policy built from the proved decomposition of a concrete preprocessed bipartite graph. No per-piece degree, sampling-tail, or tree-coverage premise is assumed. The final asymptotic lower-bound comparison remains separate."];
"Decomposition" [id="node-Decomposition",label="Decomposition\n8 checked results",tooltip="Decomposition — Iteration of the proved peeling round: every finite valid schedule yields edge-disjoint pieces with their per-round degree bounds. A final cutoff of zero gives an exact edge partition, not just a collection of partial subgraphs."];
"Density" [id="node-Density",label="Density\n7 checked results",tooltip="Density — Exact integer density characterization of the offline optimum, Section 2.2. The upper bound is proved by capacitated Hall, rather than assumed."];
"Examples" [id="node-Examples",label="Examples\n2 checked results",tooltip="Examples — Small exact regression examples. All use kernel-reduced `decide`; no native decider or external solver is used."];
"ExecutionIndex" [id="node-ExecutionIndex",label="ExecutionIndex\n10 checked results",tooltip="ExecutionIndex — Links time-labelled execution events to their original input occurrences, and represents actual threshold witness times as finite subsets of Fin T."];
"ExpectedDensity" [id="node-ExpectedDensity",label="ExpectedDensity\n9 checked results",tooltip="ExpectedDensity — Expected density lower bounds, maximized over all concrete vertex sets, including the rounding cost of an integer reference capacity. These are statements about the full source sampling model, not a presumed benchmark."];
"ExpectedMaxHits" [id="node-ExpectedMaxHits",label="ExpectedMaxHits\n4 checked results",tooltip="ExpectedMaxHits — An expectation version of the maximum-binomial bound. Jensen and the exact finite exponential moment avoid any horizon-dependent failure term."];
"ExplicitThresholdBudget" [id="node-ExplicitThresholdBudget",label="ExplicitThresholdBudget\n8 checked results",tooltip="ExplicitThresholdBudget — Quantitative budget for the concrete sufficient thresholds at doubly exponential scales. The logarithmic numerical condition is derived from a multiplicative right-branching bound, rather than assumed as a conclusion."];
"ExplicitThresholds" [id="node-ExplicitThresholds",label="ExplicitThresholds\n5 checked results",tooltip="ExplicitThresholds — An explicit rounded threshold satisfying both local numerical conditions. This finite formula is not yet bounded by the paper's asymptotic budget."];
"ForestIndices" [id="node-ForestIndices",label="ForestIndices\n6 checked results",tooltip="ForestIndices — Preorder indices of a labelled forest and their agreement with the previously counted unlabelled shape representation."];
"GraphSkew" [id="node-GraphSkew",label="GraphSkew\n7 checked results",tooltip="GraphSkew — A finite maximum log-skewness over actual bipartite subgraphs, and the bridge from this parameter to hereditary expansion and terminating peeling. Admissibility explicitly excludes zero degrees and nonpositive log denominators."];
"Greedy" [id="node-Greedy",label="Greedy\n9 checked results",tooltip="Greedy — A quantitative version of Fact 3.6, for every arrival sequence and either legal tie choice. The proof uses a doubling inequality for high-load layers."];
"GreedyBatchPropagation" [id="node-GreedyBatchPropagation",label="GreedyBatchPropagation\n4 checked results",tooltip="GreedyBatchPropagation — GraphChoices/GreedyBatchPropagation.lean"];
"GreedyCoinMarginals" [id="node-GreedyCoinMarginals",label="GreedyCoinMarginals\n3 checked results",tooltip="GreedyCoinMarginals — GraphChoices/GreedyCoinMarginals.lean"];
"GreedyExecution" [id="node-GreedyExecution",label="GreedyExecution\n4 checked results",tooltip="GreedyExecution — A bridge from a state-by-state execution to the indexed Greedy relation. The increment invariant is proved equivalent to counting assigned occurrences."];
"GreedyLowerBound" [id="node-GreedyLowerBound",label="GreedyLowerBound\n9 checked results",tooltip="GreedyLowerBound — Theorem 1.2, with explicit integer parameters, actual vertex horizon, independent fair random tie-breaking, a high-probability load lower bound, an expected offline upper bound and the stated mild degree irregularity.",shape="ellipse",fillcolor="#1c8054",fontcolor="white",color="#105b3a",penwidth="2.8",peripheries="2"];
"GreedyPropagationProbability" [id="node-GreedyPropagationProbability",label="GreedyPropagationProbability\n3 checked results",tooltip="GreedyPropagationProbability — GraphChoices/GreedyPropagationProbability.lean"];
"HorizonDecomposition" [id="node-HorizonDecomposition",label="HorizonDecomposition\n5 checked results",tooltip="HorizonDecomposition — The same decomposition policy at the actual arrival rate, with vertex bound N separate from horizon T."];
"InjectedWitnesses" [id="node-InjectedWitnesses",label="InjectedWitnesses\n4 checked results",tooltip="InjectedWitnesses — Exact probabilities for injectively assigned witness time steps. This is the independence step in the pattern bound: every required occurrence must have a distinct time, including repeated labels of the same base edge."];
"IteratedLogBounds" [id="node-IteratedLogBounds",label="IteratedLogBounds\n8 checked results",tooltip="IteratedLogBounds — Explicit integer log-log bounds for the number of decomposition classes and the Greedy multiplier after component shattering."];
"LabelledForest" [id="node-LabelledForest",label="LabelledForest\n4 checked results",tooltip="LabelledForest — A spanning first-child/next-sibling forest in every finite connected graph. Maximality is over the bounded node count, not an assumed enumeration. The distinguished root is external to the binary forest."];
"LargeShapeTail" [id="node-LargeShapeTail",label="LargeShapeTail\n1 checked result",tooltip="LargeShapeTail — Union over tree sizes as well as shapes. This avoids assuming that a large left-heavy tree contains a left-heavy subtree of an exact chosen size. Coverage by the canonical encoding is still a separate deterministic step."];
"LayeredLowerGraph" [id="node-LayeredLowerGraph",label="LayeredLowerGraph\n10 checked results",tooltip="LayeredLowerGraph — GraphChoices/LayeredLowerGraph.lean"];
"LeftEndpointPolicy" [id="node-LeftEndpointPolicy",label="LeftEndpointPolicy\n4 checked results",tooltip="LeftEndpointPolicy — GraphChoices/LeftEndpointPolicy.lean"];
"ListArrivalGraph" [id="node-ListArrivalGraph",label="ListArrivalGraph\n5 checked results",tooltip="ListArrivalGraph — Agreement between the graph of a replay, distinct list neighborhoods, and the bipartite side annotation needed by component pruning. Multiplicities are forgotten only in graph adjacency; the original list keeps every occurrence."];
"LowerFamilyLogBounds" [id="node-LowerFamilyLogBounds",label="LowerFamilyLogBounds\n6 checked results",tooltip="LowerFamilyLogBounds — GraphChoices/LowerFamilyLogBounds.lean"];
"LowerFamilyParameters" [id="node-LowerFamilyParameters",label="LowerFamilyParameters\n9 checked results",tooltip="LowerFamilyParameters — GraphChoices/LowerFamilyParameters.lean"];
"LowerGraphDegrees" [id="node-LowerGraphDegrees",label="LowerGraphDegrees\n5 checked results",tooltip="LowerGraphDegrees — GraphChoices/LowerGraphDegrees.lean"];
"LowerOfflineOptimum" [id="node-LowerOfflineOptimum",label="LowerOfflineOptimum\n2 checked results",tooltip="LowerOfflineOptimum — GraphChoices/LowerOfflineOptimum.lean"];
"MainProof" [id="node-MainProof",label="MainProof\n2 checked results",tooltip="MainProof — Theorem 1.1: a deterministic nonanticipating O(log log n)-competitive policy for every nonempty simple base graph and every arrival horizon.",shape="ellipse",fillcolor="#1c8054",fontcolor="white",color="#105b3a",penwidth="2.8",peripheries="2"];
"Model" [id="node-Model",label="Model\n18 checked results",tooltip="Model — # Samplewise graph balancing (Definition 2.1) An instance is an indexed sequence of pairs. Parallel occurrences are kept separate. Loops are allowed in this general model, so all the lemmas also apply to the loopless simple base graphs in the paper."];
"OccupancySecondMoment" [id="node-OccupancySecondMoment",label="OccupancySecondMoment\n8 checked results",tooltip="OccupancySecondMoment — Pairwise occupancy bounds suffice for expected density. The quadratic minorant below replaces a high-probability negative-association argument."];
"OriginalGraphPreprocessing" [id="node-OriginalGraphPreprocessing",label="OriginalGraphPreprocessing\n4 checked results",tooltip="OriginalGraphPreprocessing — The oriented vertex-copy construction as a concrete simple bipartite edge set, together with its proved degree certificate and label bijection."];
"PatternCoverage" [id="node-PatternCoverage",label="PatternCoverage\n4 checked results",tooltip="PatternCoverage — From an injective vertex enumeration with parent edges to a counted pattern event. The parent-before-child inequalities prove that edge labels cannot repeat, even when consecutive tree edges reverse bipartite direction. Constructing the canonical enumeration of every finite tree remains separate."];
"PatternDecay" [id="node-PatternDecay",label="PatternDecay\n2 checked results",tooltip="PatternDecay — Cancellation of branching factors against threshold-witness probabilities for a left-heavy fixed pattern. Local numerical hypotheses are explicit; the paper's chosen thresholds must still be shown to satisfy them."];
"PatternEmbeddingCount" [id="node-PatternEmbeddingCount",label="PatternEmbeddingCount\n2 checked results",tooltip="PatternEmbeddingCount — Rooted class-labelled patterns in parent-before-child order, and a bound on their graph assignments. Inconsistent bipartite side annotations simply have no assignments. Injective embeddings form a subset of these assignments."];
"PatternEventBound" [id="node-PatternEventBound",label="PatternEventBound\n5 checked results",tooltip="PatternEventBound — Combines the fixed-pattern assignment count with the actual residual-tree probability bound. Embeddings carry real base-edge labels; uniqueness follows from the base graph having at most one label per bipartite endpoint pair."];
"PatternWitnessBound" [id="node-PatternWitnessBound",label="PatternWitnessBound\n5 checked results",tooltip="PatternWitnessBound — Joint witness bound of the form used in Equations (10)--(12). Tree slots require fixed base edges. Each threshold bucket chooses an unordered set of alpha_j time steps. Only globally injective assignments are retained, so all required occurrences are distinct and the product probability is justified. The graph-to-witness encoding and pattern-embedding count are separate results."];
"Peeling" [id="node-Peeling",label="Peeling\n7 checked results",tooltip="Peeling — The finite graph-theoretic peeling step behind Lemma 3.7. This module proves extraction and termination from a hereditary neighborhood-expansion condition. The analytic-to-graph certificate is kept as an explicit premise."];
"PieceEncoding" [id="node-PieceEncoding",label="PieceEncoding\n14 checked results",tooltip="PieceEncoding — Actual edge classes and degree certificates from an exact finite graph partition. Edge labels are the base graph's concrete endpoint pairs, so simplicity and all bucket bounds are proved rather than assumed."];
"PolynomialShattering" [id="node-PolynomialShattering",label="PolynomialShattering\n5 checked results",tooltip="PolynomialShattering — Explicit logarithmic cutoffs, inverse-polynomial failure probabilities, and the expected-load consequence. The canonical-coverage containment remains an explicit premise, so these are not unconditional shattering theorems."];
"PreparedDecomposition" [id="node-PreparedDecomposition",label="PreparedDecomposition\n14 checked results",tooltip="PreparedDecomposition — The structural partition as an operational input to Threshold-Greedy. The stored bounds are derived from the proved decomposition, and the source edge labels, classes and degree certificates all use that exact partition."];
"PreprocessedComparison" [id="node-PreprocessedComparison",label="PreprocessedComparison\n7 checked results",tooltip="PreprocessedComparison — The finite preprocessed online policy has log-log expected cost times E[OPT] plus the actual graph log-skewness. The subsequent SkewLowerBound module proves the benchmark comparison needed to absorb that last graph parameter into E[OPT] in the preprocessed regime."];
"PreprocessedCompetitive" [id="node-PreprocessedCompetitive",label="PreprocessedCompetitive\n5 checked results",tooltip="PreprocessedCompetitive — The end-to-end competitive guarantee for the preprocessed graph at the vertex horizon. Skewness is now proved bounded by the benchmark, and small sizes use the deterministic horizon bound."];
"PreprocessedShattering" [id="node-PreprocessedShattering",label="PreprocessedShattering\n4 checked results",tooltip="PreprocessedShattering — The sampled-degree mean at the paper's preprocessing scale. This gives log-squared shattering directly from M ≤ d log N and 2|E| = N d for T ≤ N."];
"Preprocessing" [id="node-Preprocessing",label="Preprocessing\n5 checked results",tooltip="Preprocessing — The expected-competitive part of Lemma 2.4 and the bounded-left-degree orientation used by the preprocessing. Edge labels are preserved by the split, so the two product sampling spaces are literally the same."];
"RandomGreedy" [id="node-RandomGreedy",label="RandomGreedy\n7 checked results",tooltip="RandomGreedy — Ordinary Greedy with a fresh independent fair coin for ties. The source alphabet E × Bool records both the edge and the otherwise unused coin."];
"RateCompetitive" [id="node-RateCompetitive",label="RateCompetitive\n2 checked results",tooltip="RateCompetitive — GraphChoices/RateCompetitive.lean"];
"RealLoglogComparison" [id="node-RealLoglogComparison",label="RealLoglogComparison\n5 checked results",tooltip="RealLoglogComparison — Comparison with the bounded-at-small-n real log-log factor used by the main target. This completes the asymptotic conversion for the preprocessed N-arrival policy while retaining the skewness term explicitly for later benchmark comparison."];
"ReplayGreedyAdapter" [id="node-ReplayGreedyAdapter",label="ReplayGreedyAdapter\n11 checked results",tooltip="ReplayGreedyAdapter — The ordinary residual replay is an actual indexed Greedy orientation. Its counted loads equal the implemented state, so the checked adversarial Greedy theorem applies directly to Threshold-Greedy's residual execution."];
"ResidualAdjacency" [id="node-ResidualAdjacency",label="ResidualAdjacency\n3 checked results",tooltip="ResidualAdjacency — Every edge of the actual residual graph has an original sampled time and base-edge label. This connects graph witnesses to the occurrence-based events used in the checked probability estimates."];
"ResidualComponents" [id="node-ResidualComponents",label="ResidualComponents\n8 checked results",tooltip="ResidualComponents — Component-local bounds for the actual Threshold-Greedy state. A bound on all residual component sizes gives a deterministic bound on the full load, including thresholds, against the full sample's offline optimum."];
"ResidualDegree" [id="node-ResidualDegree",label="ResidualDegree\n6 checked results",tooltip="ResidualDegree — The degree condition used in the right-leaf pruning reduction: deleting threshold occurrences cannot increase any sampled left neighborhood. Its probability tail follows in the same i.i.d. space as the pattern bounds."];
"ResidualOptimum" [id="node-ResidualOptimum",label="ResidualOptimum\n9 checked results",tooltip="ResidualOptimum — Removing arrival occurrences cannot increase the offline optimum. This is proved via the exact density criterion and applied to the extracted residual sequence, completing the benchmark bridge for ordinary residual Greedy."];
"ResidualReplay" [id="node-ResidualReplay",label="ResidualReplay\n14 checked results",tooltip="ResidualReplay — Occurrence-preserving execution logs and exact replay of residual arrivals by a single ordinary Greedy process. Repeated edges carry distinct time labels."];
"ResidualTreeBound" [id="node-ResidualTreeBound",label="ResidualTreeBound\n5 checked results",tooltip="ResidualTreeBound — The fixed-residual-tree event is contained in the counted joint witness event. The proof uses actual execution counters and time labels, not an assumed witness-encoding hypothesis. Tree geometry is only needed later for counting embeddings and ensuring that left-vertex buckets are distinct."];
"SampleRestriction" [id="node-SampleRestriction",label="SampleRestriction\n5 checked results",tooltip="SampleRestriction — Uniform sampling is preserved by a prefix restriction; the offline optimum is monotone when arrivals are added."];
"SamplingTail" [id="node-SamplingTail",label="SamplingTail\n7 checked results",tooltip="SamplingTail — An explicit binomial upper tail proved directly in the finite i.i.d. sampling model, by selecting distinct witness time steps and union-bounding."];
"ShapeCoverage" [id="node-ShapeCoverage",label="ShapeCoverage\n1 checked result",tooltip="ShapeCoverage — A geometric embedding of an unlabelled canonical shape in the actual residual graph forces the class-labelled shape event. Edge classes and distinct occurrence witnesses are constructed from the actual execution."];
"ShapePatterns" [id="node-ShapePatterns",label="ShapePatterns\n3 checked results",tooltip="ShapePatterns — Canonical plane rooted patterns via first-child/next-sibling binary forests. A forest with m nodes encodes the m non-root vertices of a rooted tree. There are at most 4^m such shapes and |C|^m ways to label their edges."];
"ShatteringBounds" [id="node-ShatteringBounds",label="ShatteringBounds\n3 checked results",tooltip="ShatteringBounds — Probability tails for the canonical left-heavy tree family, derived from explicit local threshold conditions. The deterministic coverage of arbitrary large connected components by this family remains a separate graph theorem."];
"ShortHorizonGreedy" [id="node-ShortHorizonGreedy",label="ShortHorizonGreedy\n3 checked results",tooltip="ShortHorizonGreedy — GraphChoices/ShortHorizonGreedy.lean"];
"SkewBlockArithmetic" [id="node-SkewBlockArithmetic",label="SkewBlockArithmetic\n4 checked results",tooltip="SkewBlockArithmetic — Explicit numerical thresholds for the block proof of log-skewness. The denominator's log-squared factor pays for the number of blocks."];
"SkewDecomposition" [id="node-SkewDecomposition",label="SkewDecomposition\n18 checked results",tooltip="SkewDecomposition — The graph decomposition at the paper's doubly exponential scales, with integer capacities and an explicit termination condition. Complexity estimates and the asymptotic simplification of the degree bounds are separate from this finite existence theorem."];
"SkewExpansion" [id="node-SkewExpansion",label="SkewExpansion\n3 checked results",tooltip="SkewExpansion — The logarithmic-to-multiplicative rearrangement in the proof of Lemma 3.7. All positivity hypotheses are explicit; logarithms with zero/negative arguments or nonpositive denominators cannot silently enter the argument."];
"SkewHorizonLower" [id="node-SkewHorizonLower",label="SkewHorizonLower\n2 checked results",tooltip="SkewHorizonLower — The skewness benchmark at an arbitrary sampling horizon T, provided log N ≤ T and N bounds the base vertex count."];
"SkewLowerBound" [id="node-SkewLowerBound",label="SkewLowerBound\n2 checked results",tooltip="SkewLowerBound — Lemma 3.3 in the large-size preprocessed regime. The lower bound is derived in the exact finite sampling space, using independent blocks and a pairwise second moment rather than an assumed negative-association result."];
"SourceRelabel" [id="node-SourceRelabel",label="SourceRelabel\n10 checked results",tooltip="SourceRelabel — Changing edge-label names preserves both sampling and nonanticipating policies. A once-per-base-edge instance identifies the rounded density cap."];
"SubgraphOccupancy" [id="node-SubgraphOccupancy",label="SubgraphOccupancy\n3 checked results",tooltip="SubgraphOccupancy — A fully probabilistic lower bound for every concrete skewness witness. Its hypotheses concern only the base subgraph's degrees and cardinalities."];
"Targets" [id="node-Targets",label="Targets\n2 checked results",tooltip="Targets — # End-to-end specification This module defines the main theorem as a proposition, without assuming it. GraphChoices.MainProof proves this exact proposition as mainTheorem. The online policy receives only the preceding edge labels and current edge."];
"ThresholdBudget" [id="node-ThresholdBudget",label="ThresholdBudget\n3 checked results",tooltip="ThresholdBudget — The threshold-load calculation in Section 4.2, with integer rounding. Starting the scale index at zero only increases the bound, giving a factor 2 in front of the logarithmic term."];
"ThresholdDecay" [id="node-ThresholdDecay",label="ThresholdDecay\n4 checked results",tooltip="ThresholdDecay — Explicit logarithmic threshold conditions imply the local decay needed by the fixed-pattern probability theorem. No probability conclusion is assumed."];
"ThresholdGreedy" [id="node-ThresholdGreedy",label="ThresholdGreedy\n11 checked results",tooltip="ThresholdGreedy — Executable Threshold-Greedy, with class counters for threshold edges and separate loads for the single residual Greedy process (Algorithm 1). Counters start at zero. A counter that reaches its threshold never changes, so using threshold counters implements the threshold phase in the paper."];
"ThresholdPolicy" [id="node-ThresholdPolicy",label="ThresholdPolicy\n9 checked results",tooltip="ThresholdPolicy — The implemented full Threshold-Greedy state is an actual online policy. Its expected load and full-sample benchmark agree with the original indexed sample model, rather than a separate list-only performance notion."];
"ThresholdWitnesses" [id="node-ThresholdWitnesses",label="ThresholdWitnesses\n9 checked results",tooltip="ThresholdWitnesses — Distinct, earlier threshold occurrences are necessary witnesses for every residual arrival. Their time labels are disjoint from the entire residual log, so they cannot be reused as selected residual-tree occurrences."];
"TreePruning" [id="node-TreePruning",label="TreePruning\n12 checked results",tooltip="TreePruning — The deterministic right-leaf pruning reduction in Claim 4.3. Colors are Boolean, with true for left vertices. The retained graph contains all left vertices and all right vertices of degree at least two."];
"Uniform" [id="node-Uniform",label="Uniform\n10 checked results",tooltip="Uniform — An exact finite probability space: every function Fin T → E is equally likely. Thus edge samples are independent and uniform, with replacement. Expectations are finite averages, so no measure-theoretic assumptions are hidden."];
"WitnessEncoding" [id="node-WitnessEncoding",label="WitnessEncoding\n2 checked results",tooltip="WitnessEncoding — Deterministic encoding of disjoint tree and threshold occurrence times into the finite witness family used by the proved joint probability bound."];
"WitnessProbability" [id="node-WitnessProbability",label="WitnessProbability\n5 checked results",tooltip="WitnessProbability — Exact coordinate independence and the finite witness union bound used in Section 4.2.2. These are probability primitives, not the paper's still-open pattern-counting theorem."];
"Model" -> "AssignmentCount" [id="edge-Model--AssignmentCount"];
