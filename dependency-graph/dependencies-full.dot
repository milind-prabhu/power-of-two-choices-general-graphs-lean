"Model" -> "CapacityMatching" [id="edge-Model--CapacityMatching"];
"GreedyPropagationProbability" -> "CompleteBlockDensity" [id="edge-GreedyPropagationProbability--CompleteBlockDensity"];
"BlockDensityTailArithmetic" -> "CompleteBlockTail" [id="edge-BlockDensityTailArithmetic--CompleteBlockTail"];
"ResidualComponents" -> "ComponentExpectation" [id="edge-ResidualComponents--ComponentExpectation"];
